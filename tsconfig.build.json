{
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "outDir": "dist",

        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "lib": ["ESNext", "DOM", "WebWorker"],
        "rootDir": ".",
        "types": [
            "@types/audioworklet",
            "@webgpu/types",
            "vite/client"
        ],
        "moduleResolution": "bundler",

        "skipLibCheck": true,
    },

    "include": ["src/**/*.ts"],
    "exclude": ["src/analyser/AdvancedAnalyserNode.ts"]
}